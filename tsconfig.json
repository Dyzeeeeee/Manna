{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    /* Editor-only resolution — at build time the TisWell app provides these
       via its own Vite/TS aliases. */
    "paths": {
      "@ui/*": ["../TisWell/src/ui/*"],
      "@data/*": ["../TisWell/src/data/*"]
    }
  },
  "include": ["src", "dev", "vite.config.ts"]
}
