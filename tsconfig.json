{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,

    /* Two locations, tried in order — the sibling checkout you edit locally,
       then the git submodule that exists when building on a host. Mirrors the
       same fallback in vite.config.ts. */
    "paths": {
      "@ui/*": ["../TisWell/src/ui/*", "./TisWell/src/ui/*"],
      "@data/*": ["../TisWell/src/data/*", "./TisWell/src/data/*"]
    }
  },
  "include": ["src", "dev", "vite.config.ts"]
}
