tml", "source_location": "L1095-1122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_renderchart", "label": "renderChart", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L1129-1149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_renderpace", "label": "renderPace", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L1151-1156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_tree", "label": "TREE (expense category tree)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L624-636", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_income", "label": "INCOME (income category tree)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L637-642", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_palette", "label": "PALETTE (category colour set)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L644", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_uses", "label": "uses (subcategory frequency map)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L649", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_totals", "label": "totals (month spend by subcategory)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L650-651", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_notifs", "label": "NOTIFS (reminder store)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L788-794", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_recur", "label": "RECUR (recurring templates)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L1021-1025", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_allot", "label": "ALLOT (allotment caps)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L1037-1040", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_owed", "label": "owed (debts and loans)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L1074-1079", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_history", "label": "HISTORY (six-month in/out series)", "file_type": "code", "source_file": "manna-prototype.html", "source_location": "L1127-1128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manna_prototype_frequency_ranked_quick_log", "label": "Frequency-ranked quick-log grid", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L725-738", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Add sheet flattens every parent/subcategory pair, sorts by the `uses` counter, and shows only the top six plus an 'All categories...' escape hatch. The six most-logged things are reachable in one tap, so the common case never opens the full picker; the list re-ranks itself as habits change instead of needing manual pinning."}, {"id": "manna_prototype_parent_only_logging", "label": "Log to parent only, sort it out later", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L763-766", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Level two of the category sheet leads with a 'Log to <Parent> only - sort it out later' row, and logIt tags the meta as 'no subcategory'. A hurried log that gets sorted later beats a log that never happened, so subcategory is never allowed to block the save."}, {"id": "manna_prototype_parent_ceiling_enforcement", "label": "Twelve-parent ceiling enforcement", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L962-972", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a parent past twelve is refused outright with 'Twelve parents is the ceiling. Add a subcategory instead.' Parents are picked on every log, so they must fit one screen without scrolling; the running count hint under the list keeps the 8-12 band visible while editing."}, {"id": "manna_prototype_debt_payment_as_transfer", "label": "Debt payment logged as a transfer, not spending", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L1113-1118", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording a payment on an Owed card calls addTx with the meta 'Transfer - not a category' and no category colour. Cash drops and the obligation drops by the same amount, so nothing was consumed; giving it a category would make the reports lie."}, {"id": "manna_prototype_reminder_single_source", "label": "Reminders: one source, two surfaces", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L787-855", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single NOTIFS array drives both the Home strips (entries flagged strip:1) and the bell panel, with renderAll fanning out to both plus the badge count. Dismissal sets one flag, so the two surfaces can never disagree and dismissed items stay restorable."}, {"id": "manna_prototype_builtin_numpad", "label": "Built-in numpad instead of the system keyboard", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L607-612", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Add sheet ships its own 3x4 pad with a decimal guard (max two decimal places, nine digits) and a hardware-keyboard fallback listener. The system keyboard covers the category grid and forces typing blind; a custom pad keeps amount, note, wallet, and categories all visible at once."}, {"id": "manna_prototype_giving_floor", "label": "Giving as a floor, every other allotment a ceiling", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L485-489", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single `floor:true` entry in ALLOT renders as a highlighted card reading 'Floor met - at least 10% of income set apart', while all others read 'Ceiling - at most this much'. This one inversion is what carries the stewardship function without needing a separate God/Needs/Wants classification."}, {"id": "manna_prototype_spendable_total", "label": "Spendable grand total excludes money owed", "file_type": "rationale", "source_file": "manna-prototype.html", "source_location": "L556-571", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wallets sums six balances into one 'Everything' figure; the Owed summary sits below it in its own panel with the note that it is not part of the total. Rolling loans in would turn the number into net worth, which answers a different question from 'what can I spend today'."}, {"id": "manna_prototype_dark_palette_tokens", "label": "Manna dark palette custom properties", "file_type": "concept", "source_file": "manna-prototype.html", "source_location": "L12-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single :root block defines night/dusk/raised/bone/muted/hair plus accent, pos, and over as semantic roles rather than literal colour names, so every surface in the prototype reads from one declaration."}], "edges": [{"source": "manna_prototype_logit", "target": "manna_prototype_addtx", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L718", "weight": 1.0}, {"source": "manna_prototype_logit", "target": "manna_prototype_colorof", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L718", "weight": 1.0}, {"source": "manna_prototype_logit", "target": "manna_prototype_paint", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L720", "weight": 1.0}, {"source": "manna_prototype_logit", "target": "manna_prototype_show", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L720", "weight": 1.0}, {"source": "manna_prototype_addtx", "target": "manna_prototype_offerundo", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L702", "weight": 1.0}, {"source": "manna_prototype_offerundo", "target": "manna_prototype_peso", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L707", "weight": 1.0}, {"source": "manna_prototype_renderquick", "target": "manna_prototype_logit", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L733", "weight": 1.0}, {"source": "manna_prototype_renderquick", "target": "manna_prototype_opensheet", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manna-prototype.html", "source_location": "L737", "weight": 1.0}, {"source": "manna_prototype_openadd", "target": "manna_prototype_paint", "relation": "calls", "confidence": "