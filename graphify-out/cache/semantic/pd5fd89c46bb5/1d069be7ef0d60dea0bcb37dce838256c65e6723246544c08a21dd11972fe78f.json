urce_location": "L58", "weight": 1.0}, {"source": "roadmap_savings_goals", "target": "src_money_walletbalances", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L64-66", "weight": 1.0}, {"source": "roadmap_savings_goals", "target": "claude_wallet", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ROADMAP.md", "source_location": "L64-66", "weight": 1.0}, {"source": "roadmap_receipt_photos", "target": "claude_out_of_scope", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": "L67-69", "weight": 1.0}, {"source": "roadmap_multi_currency", "target": "claude_php_only", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": "L73-79", "weight": 1.0}, {"source": "roadmap_multi_currency", "target": "readme_integer_centavos", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L73-79", "weight": 1.0}, {"source": "roadmap_shared_expenses", "target": "roadmap_owner_scoped_permissions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L70-72, L82-85", "weight": 1.0}, {"source": "roadmap_generic_records_table", "target": "readme_namespace_convention", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L74-78", "weight": 1.0}, {"source": "roadmap_generic_records_table", "target": "roadmap_budgets", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L74-78", "weight": 1.0}, {"source": "roadmap_generic_records_table", "target": "roadmap_debts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L74-78", "weight": 1.0}, {"source": "roadmap_owner_scoped_permissions", "target": "readme_shared_instantdb", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": "L82-85", "weight": 1.0}, {"source": "roadmap_category_deletion_orphans", "target": "src_money_walletbalances", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": "L86-89", "weight": 1.0}, {"source": "roadmap_category_deletion_orphans", "target": "roadmap_categories_screen", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": "L86-89", "weight": 1.0}, {"source": "roadmap_category_deletion_orphans", "target": "claude_category_move_undecided", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "ROADMAP.md", "source_location": "L86-89", "weight": 1.0}, {"source": "roadmap_csv_export", "target": "claude_build_order", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": "L53-55", "weight": 1.0}, {"source": "roadmap_search_date_range", "target": "claude_build_order", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": "L29-33", "weight": 1.0}, {"source": "roadmap_trends", "target": "claude_month", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "ROADMAP.md", "source_location": "L50-52", "weight": 1.0}], "hyperedges": []}