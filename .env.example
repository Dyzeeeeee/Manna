# Copy to .env. Must be the SAME app id as ../TisWell/.env — that identical
# string is what makes Tiswell and Manna one database.
VITE_INSTANT_APP_ID=

# Origins Manna will accept a session from when embedded. Comma-separated.
# Anything not listed here is ignored, so keep it to Tiswell's real addresses.
VITE_TISWELL_ORIGIN=http://localhost:5173,https://tiswell.pages.dev
