# Copy to .env. Must be the SAME app id as ../TisWell/.env — that identical
# string is what makes Tiswell and Manna one database.
VITE_INSTANT_APP_ID=

# Origins Manna will accept a session from when embedded. Comma-separated.
# Anything not listed here is ignored, so keep it to Tiswell's real addresses.
VITE_TISWELL_ORIGIN=http://localhost:5173,https://tiswell.pages.dev

# Natural-language capture (optional). Leave both blank and the capture box on
# Home stays hidden — you log with the numpad wizard, which is the offline path
# anyway. Fill both in to turn capture on.
#   VITE_PARSE_URL   — the deployed manna-parse Worker URL (see worker/README.md)
#   VITE_PARSE_TOKEN — the SAME long random string you set as the Worker's
#                      APP_TOKEN secret. It ships in the bundle, so it's a soft
#                      gate (deters casual abuse); the Anthropic key stays server-
#                      side in the Worker and is never here.
VITE_PARSE_URL=
VITE_PARSE_TOKEN=
